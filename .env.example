# Local environment variables for development and testing
# Copy this file to .env and fill in with your actual values from Supabase

# Supabase - Get these from https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_KEY_HERE
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# M-Pesa Daraja
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_PASSKEY=
DARAJA_SHORTCODE=
DARAJA_CALLBACK_URL=

# Optional Vite aliases for client-side replacement
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# Admin access: comma-separated emails allowed to sign in to the admin dashboard
VITE_ADMIN_ALLOWED_EMAILS=admin@example.com
